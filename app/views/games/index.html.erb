<% content_for :title, "Ігри" %>

<%= render layout: "games/stage", locals: { title: "Ігри", back_path: alphabet_path(alphabet), back_label: "Back to Alphabet" } do %>
  <% if @games.any? %>
    <div class="mt-8 flex items-end gap-4">
      <div class="shrink-0 overflow-hidden rounded-3xl bg-red-100 shadow-md">
        <%= image_tag "christmas/santa_claus.png", alt: "Санта Клаус", class: "h-40 w-auto sm:h-52" %>
      </div>
      <p class="speech-bubble px-5 py-4 text-lg font-semibold text-gray-700">
        Привіт! Обирай гру та допоможи мені підготуватися до свята!
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      <% @games.each do |game| %>
        <%= link_to public_send(game.path_helper, alphabet), class: "group flex items-center gap-4 rounded-3xl border border-white/70 bg-white/90 p-5 card-pop transition hover:-translate-y-1" do %>
          <%= image_tag game.image, alt: "", class: "h-28 w-auto shrink-0 transition group-hover:scale-105" %>
          <div>
            <h3 class="text-2xl font-semibold text-gray-800"><%= game.title %></h3>
            <p class="mt-1 text-sm text-gray-600"><%= game.description %></p>
            <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-red-600">
              Грати <span class="text-lg transition group-hover:translate-x-1">→</span>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-8 text-gray-600">Games for this alphabet are coming soon.</p>
  <% end %>
<% end %>
